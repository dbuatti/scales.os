# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). `.env` is gitignored and never committed.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional billing. Paste a Stripe Payment Link (or Lemon Squeezy / Polar URL).
# If both are blank, /pro shows an early-access waitlist instead of checkout.
VITE_PRO_CHECKOUT_URL=
VITE_PRO_MONTHLY_URL=
VITE_PRO_ANNUAL_URL=
# Optional analytics. Leave blank to run without a provider.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
