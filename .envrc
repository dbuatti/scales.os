# scales.os — per-project env (auto-loaded by direnv on cd)
dotenv

# Supabase — shared project kyfofikkswxtwgtqutdu (with music portfolio)
export VITE_SUPABASE_URL="${VITE_SUPABASE_URL:?missing VITE_SUPABASE_URL in .env}"
export VITE_SUPABASE_ANON_KEY="${VITE_SUPABASE_ANON_KEY:?missing VITE_SUPABASE_ANON_KEY in .env}"

# OpenRouter (if this project uses AI)
export OPENROUTER_API_KEY="${OPENROUTER_API_KEY:?missing OPENROUTER_API_KEY in .env}"

# Stripe (edge functions)
export STRIPE_SECRET_KEY="${STRIPE_SECRET_KEY:?missing STRIPE_SECRET_KEY in .env}"
